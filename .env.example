OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Explicit proxy for HTTPS OpenAI requests; credentials stay local.
HTTP_PROXY=
DATABASE_URL=postgresql+psycopg://illustrations:illustrations_local@127.0.0.1:54329/illustrations
ALLOWED_ORIGINS=["http://127.0.0.1:5178","http://localhost:5178","http://127.0.0.1:8017","http://localhost:8017"]
AI_REQUEST_LIMIT=100
AI_SESSION_LIMIT=20
COOKIE_SECURE=false

# Deployment access gate. Set REQUIRE_SITE_PASSWORD=true on the server.
SITE_PASSWORD=
REQUIRE_SITE_PASSWORD=false
# Stable random signing secret (at least 32 characters). No shared test values in production.
AUTH_SECRET=

# Disable ALL experimental custom/light shadow controls and effects.
# Ordinary source shadows and shadows on supporting objects remain enabled.
# Restart the service and refresh the page after changing this flag.
CUSTOM_SHADOWS_ENABLED=true
